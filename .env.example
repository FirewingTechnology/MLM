# ====================================================================
# Binary MLM Enterprise - Environment Configuration
# ====================================================================

# Application Environment (development / production)
ENV=development
APP_ENV=development
SECRET_KEY=binary-mlm-production-secret-key-2026
JWT_SECRET_KEY=binary-mlm-jwt-secret-2026

# SQLite Persistent Database Configuration
# Local Development Path:
SQLITE_DB_PATH=./data/mlm.sqlite3
DATABASE_URL=sqlite:///./data/mlm.sqlite3

# Backups Directory
BACKUP_DIR=./data/backups

# Production Render Persistent Disk Example:
# SQLITE_DB_PATH=/var/data/mlm.sqlite3
# DATABASE_URL=sqlite:////var/data/mlm.sqlite3
# BACKUP_DIR=/var/data/backups

# Frontend URL (For Backend CORS)
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=7070

# ====================================================================
# Frontend Environment Variables (Place in frontend/.env or Render Static Site)
# ====================================================================
# Local dev: /api
# Production / Render: https://<your-backend-subdomain>.onrender.com/api
# VITE_API_URL=https://mlm-backend.onrender.com/api


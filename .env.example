# Application Secrets
SECRET_KEY=virtual-binary-mlm-secret-key-2026
JWT_SECRET_KEY=virtual-binary-mlm-jwt-secret-2026
FLASK_ENV=development

# Database (PostgreSQL or SQLite)
# Example PostgreSQL: postgresql://username:password@localhost:5432/mlm_db
# Example SQLite: sqlite:///mlm_demo.db
DATABASE_URL=sqlite:///mlm_demo.db

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Port Configuration
PORT=5000

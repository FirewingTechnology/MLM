# ====================================================================
# Virtual Binary MLM - Environment Configuration
# ====================================================================

# Application Secrets & Environment
ENV=development
SECRET_KEY=virtual-binary-mlm-secret-key-2026
JWT_SECRET_KEY=virtual-binary-mlm-jwt-secret-2026

# Database Configuration (SQLite or PostgreSQL)
# - SQLite (Instant local run): sqlite:///./mlm_demo.db
# - PostgreSQL (Render / Production): postgresql://user:password@hostname:5432/mlm_db
DATABASE_URL=sqlite:///./mlm_demo.db

# Frontend URL (For Backend CORS)
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=7070

# ====================================================================
# Frontend Environment Variables (Place in frontend/.env or Render Static Site)
# ====================================================================
# Local dev: /api
# Production / Render: https://<your-backend-subdomain>.onrender.com/api
# VITE_API_URL=https://mlm-backend.onrender.com/api

# ====================================================================
# Matching MLM Enterprise - Environment Configuration
# ====================================================================

# Application Environment (development / production)
ENV=development
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-in-production

# ====================================================================
# Database Configuration
# ====================================================================

# Production AWS RDS PostgreSQL Configuration:
# DATABASE_URL=postgresql+psycopg://username:password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/mystatus_postgres

# Local / Development PostgreSQL Configuration:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mlm_db

# Local SQLite Development Fallback (Only for local development):
SQLITE_DB_PATH=./data/mlm.sqlite3
DATABASE_URL=sqlite:///./data/mlm.sqlite3

# Backups Directory (For SQLite snapshots / archive)
BACKUP_DIR=./data/backups

# ====================================================================
# Initial Administrator Provisioning (One-time bootstrap)
# ====================================================================
# Set to 'true' only for the initial deployment to create the first admin account.
# Once created, set back to 'false'. Existing admin accounts are NEVER overwritten.
INITIAL_ADMIN_BOOTSTRAP=false
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=replace-with-secure-admin-password-min-8-chars
INITIAL_ADMIN_MOBILE=9876500001
INITIAL_ADMIN_NAME=System Admin

# ====================================================================
# Server & Network Configuration
# ====================================================================

# Frontend URL (For Backend CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Port
PORT=7070

# ====================================================================
# Frontend Environment Variables (Place in frontend/.env)
# ====================================================================
# Local dev: /api
# Production: https://api.yourdomain.com/api
# VITE_API_URL=https://api.yourdomain.com/api
